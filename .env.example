# Root 하나만 사용한다.
# - Vercel: repo root에 이 변수들을 Environment Variables로 등록
# - 로컬 웹: npm run dev
# - 로컬 워커: cd worker && .venv/bin/python worker.py

# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 서버 액션에서 AI 보고서 생성에 사용한다. 브라우저에 노출되지 않는 이름으로 유지.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REPORT_MODEL=gpt-5.4-mini

# 워커 설정
POLL_INTERVAL_SEC=5
POSE_MODEL=yolo11n-pose.pt
ANOMALY_WINDOW_FRAMES=32
ANOMALY_STRIDE_FRAMES=8
ANOMALY_THRESHOLD_STD=2.5
ANOMALY_MIN_SEGMENT_FRAMES=16
WORK_DIR=./tmp
