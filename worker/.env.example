# Supabase 프로젝트 설정 > API 에서 확인. 워커는 RLS를 우회해야 하므로
# service_role 키를 쓴다 (절대 프론트엔드/브라우저에 노출하지 말 것).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 폴링 주기 (초)
POLL_INTERVAL_SEC=5

# YOLO11-pose 가중치 (최초 실행 시 ultralytics가 자동 다운로드)
POSE_MODEL=yolo11n-pose.pt

# 이상행동 탐지 파라미터
ANOMALY_WINDOW_FRAMES=32
ANOMALY_STRIDE_FRAMES=8
ANOMALY_THRESHOLD_STD=2.5
ANOMALY_MIN_SEGMENT_FRAMES=16

# 임시 작업 디렉토리 (다운로드한 원본 영상, 추출 클립 등)
WORK_DIR=./tmp
